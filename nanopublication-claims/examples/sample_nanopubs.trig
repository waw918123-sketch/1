<http://purl.org/nanopub/local/example_nanopub_20_synthetic/np_003#assertion> {
  npdoc:entity_Patient_age_survived_group_f173930b rdfs:label "Patient age (survived group)" ;
    npprop:no_significant_difference "Patient age (deceased group)" .
  <http://purl.org/nanopub/local/example_nanopub_20_synthetic/np_003#statement> a rdf:Statement ;
    rdf:subject npdoc:entity_Patient_age_survived_group_f173930b ;
    rdf:predicate npprop:no_significant_difference ;
    rdf:object "Patient age (deceased group)" ;
    rdfs:label "Patient age shows no statistically significant difference between survived and deceased groups." ;
    npprop:polarity "no_difference" ;
    npprop:conditions "n = 21 patients, 6-month follow-up" ;
    npprop:statistics "p = 0.33" ;
    npprop:studyDesign "observational" .
}

