  <http://purl.org/nanopub/local/example_nanopub_20_synthetic/np_004#statement> a rdf:Statement ;
    rdf:subject npdoc:entity_EEG_alpha_synchrony_index_410d0fe5 ;
    rdf:predicate npprop:correlates_with ;
