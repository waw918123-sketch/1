<http://purl.org/nanopub/local/example_nanopub_20_synthetic/np_001#assertion> {
  npdoc:entity_Catalyst_Alpha_CA-1_614cef8f rdfs:label "Catalyst Alpha (CA-1)" ;
    npprop:increases "CO2 conversion rate to 88.5%" .
  <http://purl.org/nanopub/local/example_nanopub_20_synthetic/np_001#statement> a rdf:Statement ;
    rdf:subject npdoc:entity_Catalyst_Alpha_CA-1_614cef8f ;
    rdf:predicate npprop:increases ;
    rdf:object "CO2 conversion rate to 88.5%" ;
    rdfs:label "Catalyst Alpha (CA-1) increases CO2 conversion rate to 88.5% under fixed-bed flow." ;
    npprop:polarity "positive" ;
    npprop:conditions "723 K, 2.0 MPa, GHSV 3000 h^-1" ;
    npprop:statistics "88.5 ± 1.2%" ;
    npprop:studyDesign "experimental" .
}

<http://purl.org/nanopub/local/example_nanopub_20_synthetic/np_001#provenance> {
  <http://purl.org/nanopub/local/example_nanopub_20_synthetic/np_001#assertion> prov:wasGeneratedBy "fixed_bed_gc_measurement" ;
    npprop:evidenceType "direct_observation" ;
    npprop:confidence "high" ;
    npprop:confidenceBasis "Directly measured in Table 1 cell with explicit temperature, pressure, and uncertainty." .
  <http://purl.org/nanopub/local/example_nanopub_20_synthetic/np_001#assertion> cito:citesAsEvidence <http://purl.org/nanopub/local/example_nanopub_20_synthetic/np_001#evidence_1> .
  <http://purl.org/nanopub/local/example_nanopub_20_synthetic/np_001#evidence_1> a prov:Entity ;
    npprop:docId "doc_1" ;
    npprop:page 2 ;
    npprop:printedPage "unreported" ;
    npprop:sectionId "unreported" ;
    npprop:blockId "unreported" ;
    npprop:tableId "tbl_1" ;
    npprop:rowLabel "CA-1" ;
    npprop:colHeader "Conversion (%)" ;
    npprop:cellValue "88.5" ;
    npprop:quoteSha256 "none" ;
    prov:value "CA-1 achieved 88.5 ± 1.2% CO2 conversion at 723 K and 2.0 MPa." .
}

