<http://purl.org/nanopub/local/example_nanopub_20_synthetic/np_007#assertion> {
  npdoc:entity_Caffeine_200_mg_oral_002e938c rdfs:label "Caffeine (200 mg oral)" ;
    npprop:decreases "simulated braking reaction time to 0.84 s" .
  <http://purl.org/nanopub/local/example_nanopub_20_synthetic/np_007#statement> a rdf:Statement ;
    rdf:subject npdoc:entity_Caffeine_200_mg_oral_002e938c ;
    rdf:predicate npprop:decreases ;
    rdf:object "simulated braking reaction time to 0.84 s" ;
    rdfs:label "Single 200 mg caffeine dose decreases simulated braking reaction time to 0.84 s." ;
    npprop:polarity "negative" ;
    npprop:conditions "Double-blind RCT, n = 50 per arm, 60 min post-dose" ;
    npprop:statistics "0.84 s vs 0.91 s placebo" ;
    npprop:studyDesign "rct" .
}

