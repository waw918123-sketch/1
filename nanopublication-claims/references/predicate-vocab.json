{
  "_schema": "nanopublication-controlled-predicates/v1",
  "predicates": {
    "increases": {
      "category": "directional_effect",
      "requires_conditions": true,
      "causal": true,
      "aliases": ["elevates", "raises", "enhances", "upregulates", "boosts", "augments", "promotes", "aggravates"],
      "opposite": "decreases"
    },
    "decreases": {
      "category": "directional_effect",
      "requires_conditions": true,
      "causal": true,
      "aliases": ["reduces", "lowers", "diminishes", "downregulates", "attenuates", "suppresses", "mitigates"],
      "opposite": "increases"
    },
    "causes": {
      "category": "causal",
      "requires_conditions": true,
      "causal": true,
      "forbidden_study_designs": ["observational", "cross_sectional", "retrospective", "case_control", "correlational"],
      "aliases": ["induces", "triggers", "drives", "leads_to", "produces", "results_in", "establishes_causal"]
    },
    "inhibits": {
      "category": "causal",
      "requires_conditions": true,
      "causal": true,
      "aliases": ["blocks", "prevents", "represses", "antagonizes"]
    },
    "activates": {
      "category": "causal",
      "requires_conditions": true,
      "causal": true,
      "aliases": ["stimulates", "phosphorylates", "catalyzes", "induces_activity"]
    },
    "correlates_with": {
      "category": "statistical_association",
      "requires_conditions": true,
      "causal": false,
      "aliases": ["associated_with", "positively_correlates_with", "negatively_correlates_with", "co_occurs_with"]
    },
    "predicts": {
      "category": "predictive_association",
      "requires_conditions": true,
      "causal": false,
      "aliases": ["prognostic_for", "forecasts", "biomarker_for", "discriminates"]
    },
    "differs_from": {
      "category": "group_comparison",
      "requires_conditions": true,
      "causal": false,
      "aliases": ["higher_than", "lower_than", "outperforms", "exceeds", "differs_between"]
    },
    "no_significant_difference": {
      "category": "null_comparison",
      "requires_conditions": true,
      "causal": false,
      "aliases": ["not_significantly_different_from", "comparable_in_p_value", "non_significant_difference"]
    },
    "measured_as": {
      "category": "quantitative_measurement",
      "requires_conditions": true,
      "causal": false,
      "aliases": ["equals", "has_value", "reported_as", "estimated_as", "quantified_as", "observed_at"]
    },
    "characterized_by": {
      "category": "property_or_attribute",
      "requires_conditions": false,
      "causal": false,
      "aliases": ["exhibits", "has_property", "contains", "has_concentration", "has_structure"]
    },
    "derived_from": {
      "category": "methodological_provenance",
      "requires_conditions": true,
      "causal": false,
      "aliases": ["extrapolated_from", "fitted_with", "modeled_by", "synthesized_via"]
    },
    "treats_or_improves": {
      "category": "intervention_outcome",
      "requires_conditions": true,
      "causal": true,
      "aliases": ["ameliorates", "rescues", "protects_against"]
    },
    "fails_to_show": {
      "category": "negative_or_null_finding",
      "requires_conditions": true,
      "causal": false,
      "aliases": ["does_not_support", "not_associated_with", "no_effect_on", "lacks_evidence_for"]
    },
    "not_reported": {
      "category": "missing_evidence",
      "requires_conditions": false,
      "causal": false,
      "aliases": ["unreported", "indeterminate", "not_tested"]
    }
  },
  "vague_predicates": [
    "relates_to", "related_to", "involves", "shows", "mentions", "discusses", "affects", "impacts", "links"
  ]
}
